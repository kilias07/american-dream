{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "american-dream",
  // Konto Cloudflare KLIENTA (Admin@americandreamclub.pl) — migracja 2026-08-03.
  "account_id": "728f583cb91698be32ab0744f50b80f9",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // Retention cron (spec §7): anonymise reservation personal data 12 months after
  // the event. Cloudflare invokes the worker's scheduled handler daily at 03:00.
  // The handler must reach /api/cron/anonymize with CRON_SECRET — confirm the
  // scheduled→fetch bridge for the OpenNext worker at deploy (or point an external
  // scheduler at the URL with the secret).
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "7f8a5dce-b13a-4db7-99c4-189c0a6ac0fe",
      "database_name": "american-dream",
      "remote": true,
    },
    {
      // OSOBNA baza na tag-cache OpenNext (fix 2026-08-05): współdzielenie
      // jednej D1 z treścią powodowało kontencję zapisu — przy kilku zapisach
      // w adminie pod rząd co któryś padał 500 „Something went wrong".
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "d07b4d5a-bab9-409e-a9f7-abd67db56d93",
      "database_name": "american-dream-tag-cache",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "american-dream",
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "american-dream",
    },
  ],

  // Cloudflare Email Service — transactional e-mail for the reservation system
  // (spec §6). Uncomment once the Email Sending binding is provisioned and the
  // domain's SPF/DKIM DNS records are in place. The reservation code already
  // reads this binding by name (SEND_EMAIL) and no-ops gracefully until then.
  // "send_email": [
  //   { "name": "SEND_EMAIL" },
  // ],

  // ── Środowisko robocze (staging) ─────────────────────────────────────────
  // Osobny worker do akceptacji zmian przez klienta, zanim trafią na żywą
  // stronę. Wdrożenie: `CLOUDFLARE_ENV=staging pnpm run deploy:app`
  //
  // ŚWIADOMIE osobna baza D1 — współdzielenie produkcyjnej oznaczałoby, że
  // każda pomyłka w trakcie prac (albo migracja nowej funkcji) dotyka żywej
  // strony. Tag-cache też osobny, żeby unieważnianie cache nie przenosiło się
  // między środowiskami.
  //
  // R2 współdzielone z produkcją CELOWO: zdjęcia mają być te same, a cache stron
  // jest kluczowany identyfikatorem builda, więc oba środowiska się nie mieszają.
  //
  // Adres `*.workers.dev` jest automatycznie oznaczany jako noindex
  // (patrz next.config.ts) — wersja robocza nie zaszkodzi pozycjonowaniu.
  "env": {
    "staging": {
      "name": "american-dream-staging",
      "account_id": "728f583cb91698be32ab0744f50b80f9",
      "compatibility_date": "2025-08-15",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "0c1d40f6-bcc1-4fe7-af6d-cbeb75d2a26f",
          "database_name": "american-dream-staging",
          "remote": true,
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_id": "40b013b9-d80e-410b-9cc2-7c0e26dcaeec",
          "database_name": "american-dream-staging-tag-cache",
          "remote": true,
        },
      ],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "american-dream" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "american-dream" },
      ],
    },
  },
}
