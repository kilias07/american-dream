# Publiczny origin produkcji. MUSI być docelową domeną — nigdy adresem
# *.workers.dev: z niego lecą canonical, hreflang, og:url, sitemap.xml,
# llm.txt, robots.txt i JSON-LD (audyt SEO 2026-08-06, punkt krytyczny nr 1).
# src/utilities/siteUrl.ts dodatkowo odrzuca hosty *.workers.dev jako
# zabezpieczenie, gdyby ta zmienna kiedyś znów wskazała środowisko robocze.
NEXT_PUBLIC_SERVER_URL=https://americandreamclub.pl

# Publiczny host magazynu R2 (bucket `american-dream`). Stąd idą wszystkie
# uploady: obrazy przez Cloudflare Image Transformations (/cdn-cgi/image/) oraz
# wideo. Dzięki temu pliki NIE przechodzą przez Workera — mają cache CDN i nie
# kosztują wywołania Workera przy każdym wyświetleniu.
NEXT_PUBLIC_MEDIA_URL=https://media.americandreamclub.pl

# Usercentrics CMP (v3) — identyfikator konfiguracji zgód dla americandreamclub.pl.
# Publiczny (trafia do kodu strony). Zmiana = inna konfiguracja banera.
NEXT_PUBLIC_UC_SETTINGS_ID=N_bm8Ovsq8KE90
